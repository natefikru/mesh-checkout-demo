# Mesh dashboard > Account > API keys
# Also add http://localhost:3000 and your Vercel domain under "Access",
# or the Link iframe will refuse to render.
MESH_CLIENT_ID=
MESH_API_KEY=

# Defaults to the sandbox when unset. Do not point this at production.
MESH_BASE_URL=https://sandbox-integration-api.meshconnect.com

# Mesh dashboard > Account > API keys > Webhooks. Shown once on creation.
# Configured per environment; sandbox and production do not share a value.
MESH_WEBHOOK_SECRET=

# Upstash Redis, provisioned through the Vercel marketplace integration.
# `vercel integration add upstash/upstash-kv` provisions these automatically;
# note the Vercel-convention names (KV_REST_API_*), not Upstash's own.
KV_REST_API_URL=
KV_REST_API_TOKEN=
